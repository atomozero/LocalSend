/*
 * LocalSend for Haiku - Application resources
 */

resource app_signature "application/x-vnd.LocalSend";

// B_BACKGROUND_APP: l'app non appare nel leaf menu della Deskbar (lista
// dei programmi in esecuzione) ne' nel Twitcher. Necessario perche'
// LocalSend continua a girare in background col solo replicant in vista,
// e l'utente non deve vederla come "ancora aperta" dopo aver chiuso la
// finestra. Le finestre normali continuano a comportarsi come sempre.
resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 1,
	minor  = 1,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "LocalSend",
	long_info = "Share files over LAN with any device running LocalSend."
};

resource(1, "BEOS:FILE_TYPES") message {
	"types" = "application/x-vnd.LocalSend"
};

